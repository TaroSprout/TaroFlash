# Local dev defaults, so `vp dev` runs the app without Doppler.
#
# Nothing here is a secret: every VITE_ var is inlined into the client bundle at
# build time and shipped to every visitor, so a value that must stay private
# cannot live behind this prefix in the first place. These are the Supabase
# CLI's fixed local values (identical on every machine) and Stripe's test-mode
# publishable key.
#
# `pnpm dev` still wins: Vite gives process.env precedence over .env files, so
# the values `doppler run` injects override these.
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_API_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Both must stay in the auth redirect allow-list in supabase/config.toml, which
# only permits port 5173 — a dev server on another port can't complete a login.
VITE_AUTH_REDIRECT_URL=http://localhost:5173/auth/callback
VITE_RESET_PASSWORD_REDIRECT_URL=http://localhost:5173/welcome

VITE_STRIPE_PUBLIC_KEY=pk_test_51SUx5oIuBoRqjURohxMw11loMzike4SUcygRWZBpoYfbQmxptZLJ6s4eFKRhcXmy1n2apGwxFTnbG6wx00khC1hS00oKs4TN5o
VITE_MEMBERSHIP_PRICE_ID=price_1SUwl7EzDieOn78MbAPwsiv8
